---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import kit from '../../kit.json';
import '../styles/tokens.css';
// A site's own folder, src/custom/. Each file is optional; with none, the page is the kit's alone.
const customCss = import.meta.glob('../custom/custom.css', { eager: true });
const customParts = import.meta.glob('../custom/{Header,Footer}.astro', { eager: true });
const CustomHeader = (customParts['../custom/Header.astro'] as any)?.default;
const CustomFooter = (customParts['../custom/Footer.astro'] as any)?.default;

interface EventFacts {
  title: string;
  description: string;
  start: string;
  end?: string;
  online?: boolean;
  location?: string;
  signup?: string;
}
interface Props {
  title: string;
  description: string;
  article?: CollectionEntry<'articles'>;
  event?: { data: EventFacts };
  documentTitle?: string;
  noindex?: boolean;
  hidden?: boolean;
  showTitle?: boolean;
  image?: string;
}
const { title, description, article, event, documentTitle, noindex, hidden, showTitle, image: pageImage } = Astro.props;
interface SiteLink { label: string; href: string; style?: string }
interface LayoutBrand { text?: string; logo?: string }
interface LayoutConfig {
  width?: string;
  sections?: string;
  header?: { brand?: LayoutBrand; sticky?: boolean; menu?: string };
}
const site = kit as typeof kit & { nav?: SiteLink[]; footer?: SiteLink[]; siteName?: string; layout?: LayoutConfig; icon?: string; lang?: string };
if (!title?.trim() || !description?.trim()) {
  throw new Error('Every page requires a title and description.');
}
const SITE_URL = kit.siteUrl;
// With build.format 'file' the build-time pathname ends in .html (/index.html, /articles/x.html); the public URL does not.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/+$/, '') || '/';
const canonical = SITE_URL + path;
const image = new URL(article?.data.hero ?? pageImage ?? '/images/og-default.png', SITE_URL).href;
const home = await getEntry('pages', 'index');
const [about] = await getCollection('pages', ({ id, data }) => id === 'about' && !data.draft);
const organization = about && !about.data.draft ? about.data.organization : undefined;
const organizationId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;
// The person a site declares in kit.json, for a profile site. Only what the site declares is emitted; nothing is filled in.
interface PersonOrg { name: string; url?: string }
interface PersonFounded { name: string; url?: string; alternateName?: string[]; parentOrganization?: PersonOrg }
interface PersonBook { name: string; isbn: string; publisher: string; datePublished: string; bookEdition?: string; url?: string; coAuthors?: { name: string; type?: string }[] }
interface PersonDecl { name: string; page?: string; url?: string; image?: string; jobTitle?: string; worksFor?: PersonOrg; knowsAbout?: string[]; sameAs?: string[]; founded?: PersonFounded[]; books?: PersonBook[] }
const person = (site as typeof site & { person?: PersonDecl }).person;
const personId = `${SITE_URL}/#person`;
// An Organization node is emitted only when the site states organization facts; an empty one carries nothing but its @id.
const publisherId = person ? personId : organization ? organizationId : undefined;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${SITE_URL}/`,
    name: site.siteName ?? home?.data.title ?? title,
    inLanguage: typeof site.lang === 'string' && site.lang ? site.lang : 'en',
    ...(publisherId ? { publisher: { '@id': publisherId } } : {}),
  },
  ...(organization ? [{
    '@type': 'Organization',
    '@id': organizationId,
    ...organization,
    ...(organization.logo ? { logo: new URL(organization.logo, SITE_URL).href } : {}),
  }] : []),
];
if (person) {
  graph.push({
    '@type': 'Person',
    '@id': personId,
    name: person.name,
    url: person.url ?? `${SITE_URL}/`,
    ...(person.image ? { image: new URL(person.image, SITE_URL).href } : {}),
    ...(person.jobTitle ? { jobTitle: person.jobTitle } : {}),
    ...(person.worksFor ? { worksFor: { '@type': 'Organization', name: person.worksFor.name, ...(person.worksFor.url ? { url: person.worksFor.url } : {}) } } : {}),
    ...(person.knowsAbout?.length ? { knowsAbout: person.knowsAbout } : {}),
    ...(person.sameAs?.length ? { sameAs: person.sameAs } : {}),
  });
  const profilePath = !person.page || person.page === 'index' ? '/' : `/${person.page}`;
  if (path === profilePath) {
    graph.push({ '@type': 'ProfilePage', '@id': `${canonical}#profilepage`, url: canonical, name: title, isPartOf: { '@id': websiteId }, mainEntity: { '@id': personId } });
    for (const [n, org] of (person.founded ?? []).entries()) {
      graph.push({
        '@type': 'Organization',
        '@id': `${SITE_URL}/#founded-${n + 1}`,
        name: org.name,
        ...(org.url ? { url: org.url } : {}),
        ...(org.alternateName?.length ? { alternateName: org.alternateName } : {}),
        founder: { '@id': personId },
        ...(org.parentOrganization ? { parentOrganization: { '@type': 'Organization', name: org.parentOrganization.name, ...(org.parentOrganization.url ? { url: org.parentOrganization.url } : {}) } } : {}),
      });
    }
    for (const book of person.books ?? []) {
      const isbn = book.isbn.replace(/[\s-]/g, '');
      graph.push({
        '@type': 'Book',
        '@id': `${SITE_URL}/#book-${isbn}`,
        name: book.name,
        author: [{ '@id': personId }, ...(book.coAuthors ?? []).map((co) => ({ '@type': co.type === 'Organization' ? 'Organization' : 'Person', name: co.name }))],
        publisher: { '@type': 'Organization', name: book.publisher },
        datePublished: book.datePublished,
        isbn,
        ...(book.bookEdition ? { bookEdition: book.bookEdition } : {}),
        ...(book.url ? { url: book.url } : {}),
      });
    }
  }
}
if (article) {
  const author = await getEntry(article.data.author);
  if (!author) throw new Error(`Unknown author for article ${article.id}`);
  graph.push({
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: title,
    description,
    datePublished: article.data.pubDate.toISOString(),
    image,
    url: canonical,
    mainEntityOfPage: canonical,
    isPartOf: { '@id': websiteId },
    ...(organization ? { publisher: { '@id': organizationId } } : {}),
    author: { '@type': author.data.type ?? 'Person', name: author.data.name, ...(author.data.url ? { url: author.data.url } : {}) },
    keywords: article.data.tags,
  });
}
if (event) {
  graph.push({
    '@type': 'Event',
    name: event.data.title,
    description: event.data.description,
    startDate: event.data.start,
    ...(event.data.end ? { endDate: event.data.end } : {}),
    eventAttendanceMode: event.data.online === true ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
    location: event.data.online === true
      ? { '@type': 'VirtualLocation', url: event.data.signup || canonical }
      : { '@type': 'Place', name: event.data.location },
    url: canonical,
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const articlesOn = kit.collections.articles !== false;
const layoutConfig = site.layout;
const hasLayout = layoutConfig !== undefined && layoutConfig !== null && typeof layoutConfig === 'object' && !Array.isArray(layoutConfig);
const width = layoutConfig?.width === 'wide' ? 'wide' : 'narrow';
const sections = layoutConfig?.sections === 'bands' ? 'bands' : 'column';
const header = layoutConfig?.header && typeof layoutConfig.header === 'object' ? layoutConfig.header : {};
const sticky = header.sticky === true;
const menu = header.menu === 'button' ? 'button' : 'links';
const brand = header.brand && typeof header.brand === 'object' ? header.brand : undefined;
const brandText = typeof brand?.text === 'string' && brand.text.trim() ? brand.text : '';
const brandLogo = typeof brand?.logo === 'string' && brand.logo ? brand.logo : '';
const brandLabel = site.siteName || home?.data.title || title;
const links: SiteLink[] = site.nav ?? (articlesOn
  ? [{ label: 'Home', href: '/' }, { label: 'RSS', href: '/rss.xml' }]
  : [{ label: 'Home', href: '/' }]);
// Behind a Menu control on a phone, a button-style link stays beside the control rather than inside it.
const buttonLinks = links.filter((item) => item.style === 'button');
const menuLinks = links.filter((item) => item.style !== 'button');
const lang = typeof site.lang === 'string' && site.lang ? site.lang : 'en';
const icon = typeof site.icon === 'string' && site.icon ? site.icon : '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {icon && <link rel="icon" href={icon} />}
    <title>{documentTitle ?? title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {hidden && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {!organization && <meta name="kit:organization" content="Organization facts omitted: no published about page with organization details is bound." />}
    <script type="application/ld+json" set:html={jsonLd} />
    {articlesOn && <link rel="alternate" type="application/rss+xml" title="Articles" href={`${SITE_URL}/rss.xml`} />}
  </head>
  <body data-kit-layout={hasLayout ? "" : undefined} data-width={hasLayout ? width : undefined} data-sections={hasLayout ? sections : undefined} data-pagefind-ignore={hidden ? "all" : undefined}>
    <a class="skip-link" href="#content">Skip to content</a>
    {CustomHeader ? <CustomHeader nav={links} siteName={brandLabel} brand={brand} path={path} /> : hasLayout ? ((links.length > 0 || brandText || brandLogo) &&
      <header data-sticky={sticky ? "" : undefined}>
        <div class="site-bar">
          {(brandText || brandLogo) && <a class="site-brand" href="/">
            {brandLogo && <img src={brandLogo} alt={brandText ? '' : brandLabel} />}
            {brandText && <span>{brandText}</span>}
          </a>}
          {menu === 'button' ? (
            <>
              {links.length > 0 && <nav class="site-nav-inline" aria-label="Main">{links.map((item) => <a href={item.href} data-style={item.style === 'button' ? 'button' : undefined}>{item.label}</a>)}</nav>}
              {buttonLinks.length > 0 && <nav class="site-nav-actions" aria-label="Actions">{buttonLinks.map((item) => <a href={item.href} data-style="button">{item.label}</a>)}</nav>}
              {menuLinks.length > 0 && <details class="site-nav-menu">
                <summary>Menu</summary>
                <nav aria-label="Main">{menuLinks.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
              </details>}
            </>
          ) : (links.length > 0 &&
            <nav aria-label="Main">{links.map((item) => <a href={item.href} data-style={item.style === 'button' ? 'button' : undefined}>{item.label}</a>)}</nav>
          )}
        </div>
      </header>
    ) : site.nav === undefined ? (
      articlesOn
        ? <header><nav aria-label="Main"><a href="/">Home</a><a href="/rss.xml">RSS</a></nav></header>
        : <header><nav aria-label="Main"><a href="/">Home</a></nav></header>
    ) : (site.nav.length > 0 &&
      <header><nav aria-label="Main">{site.nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav></header>
    )}
    <main id="content" class="prose" data-pagefind-body={noindex || hidden ? undefined : ""}>
      {showTitle === false ? null : <h1>{title}</h1>}
      <slot />
    </main>
    {CustomFooter ? <CustomFooter footer={site.footer ?? []} siteName={brandLabel} path={path} /> : site.footer !== undefined && (hasLayout
      ? <footer><div class="site-bar"><nav aria-label="Footer">{site.footer.map((item) => <a href={item.href}>{item.label}</a>)}</nav></div></footer>
      : <footer><nav aria-label="Footer">{site.footer.map((item) => <a href={item.href}>{item.label}</a>)}</nav></footer>)}
  </body>
</html>
