---
interface Props {
  title?: string;
  youtube?: string;
  vimeo?: string;
  src?: string;
}
const { title, youtube, vimeo, src } = Astro.props;
const idOk = /^[A-Za-z0-9_-]+$/;
const chosen = [
  youtube !== undefined && youtube !== '' ? 'youtube' : '',
  vimeo !== undefined && vimeo !== '' ? 'vimeo' : '',
  src !== undefined && src !== '' ? 'src' : '',
].filter(Boolean);
if (typeof title !== 'string' || title.trim() === '') throw new Error('Video requires a title.');
if (chosen.length !== 1) throw new Error('Video requires exactly one of youtube, vimeo, or src.');
let address = '';
if (chosen[0] === 'youtube') {
  if (!idOk.test(youtube ?? '')) throw new Error('Video youtube id must be letters, digits, hyphens or underscores.');
  address = `https://www.youtube-nocookie.com/embed/${youtube}`;
} else if (chosen[0] === 'vimeo') {
  if (!idOk.test(vimeo ?? '')) throw new Error('Video vimeo id must be letters, digits, hyphens or underscores.');
  address = `https://player.vimeo.com/video/${vimeo}?dnt=1`;
} else {
  if (typeof src !== 'string' || !src.startsWith('/images/') || src.includes('..') || src.includes('\\') || src.includes('?') || src.includes('#')) {
    throw new Error('Video src must be a file under /images/.');
  }
  address = src;
}
const box = 'position:relative;width:100%;aspect-ratio:16/9';
const fill = 'position:absolute;inset:0;width:100%;height:100%';
---
<div style={box}>
  {chosen[0] === 'src'
    ? <video controls preload="metadata" aria-label={title} src={address} style={fill}></video>
    : <iframe title={title} src={address} loading="lazy" allowfullscreen style={`${fill};border:0`}></iframe>}
</div>
