---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { components } from '../../components/index.js';
import { formatEventWhen } from '../../lib/event-time.mjs';

export async function getStaticPaths() {
  // A route runs from a bundled copy at build time, so a path relative to this file finds nothing; a glob resolves against the source.
  if (Object.keys(import.meta.glob('../../content/events/**/*.{md,mdx}')).length === 0) return [];
  const events = await (getCollection as (name: string, filter: (entry: { data: { draft?: boolean } }) => boolean) => Promise<{ id: string; data: Record<string, unknown> }[]>)('events', ({ data }) => !data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const when = formatEventWhen(event.data.start, event.data.end, event.data.timezone);
const place = event.data.online ? 'Online' : event.data.location;
const linkStyle = 'display:inline-flex;align-items:center;box-sizing:border-box;min-height:44px';
---
<SiteLayout title={event.data.title} description={event.data.description} event={event}>
  <p>{when}</p>
  <p>{place}</p>
  {event.data.signup && <p><a href={event.data.signup} style={linkStyle}>Sign up</a></p>}
  <Content components={components} />
</SiteLayout>
