{
  "roles": ["runtime", "readonly"],
  "default_role": "runtime",
  "rules": [
    { "role": "readonly", "privilege": ["write", "admin"], "effect": "deny" },
    { "role": "runtime",  "privilege": "admin",            "effect": "deny" },
    { "role": "runtime",  "risk": "destructive",           "effect": "confirm" },
    { "role": "runtime",  "op": "startConnect",            "effect": "allow" },
    { "role": "readonly", "op": "disconnect",              "effect": "deny" },
    { "role": "runtime",  "op": "disconnect",              "effect": "confirm" },
    { "role": "*", "service": "wiser", "privilege": "read", "op": "execute", "effect": "allow" },
    { "role": "*",        "effect": "allow" }
  ]
}
