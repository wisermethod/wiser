.DS_Store
.stfolder/
node_modules/
infrastructure/release/dist/
._*
.Spotlight-V100
.Trashes
.stversions/

# Plugin-copy consent. Written on the first authorised install in this copy;
# not a file this repository ships.
.wiser-consent

# Tool install artifacts. A tool installs its dependencies on the user's own
# machine when that tool is called; this repository ships manifests and never
# packages, and none of what an install leaves behind is committable.
.venv/
__pycache__/
*.egg-info/

# Model and browser caches. Named from the directories the tools actually
# create: transcribe.py writes speech-models and cache under the --model-cache
# directory the caller passes, and playwright downloads a Chromium build into
# ms-playwright.
.cache/
speech-models/
ms-playwright/
