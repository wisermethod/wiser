#!/bin/sh
# Three checks, on the staged set only.
#
# Why these and not the others: over the 52 commits of the Close-out range, the
# em-dash sweep fired zero times, the retired-word sweep fired zero times, and
# the operator-path check fired once, on a path the producer committed the same
# morning after writing the rule into ten separate briefs. A checklist whose
# items never fire trains its reader to skip the list, so the list was one item
# long.
#
# The second item was added 2026-09-19 by the operator, against that principle
# and knowing it. What earns the exception is that this check has already fired
# for real rather than in theory: on the day the clause it proves was written,
# ten of Browser Control's fifty flags were absent from its typed file, and the
# gap was found by hand after a session read that file, believed the list was
# complete, and wrote a call that would have discarded an approved post body.
# The first item is a rule nobody breaks; this one is a rule somebody just did.
#
# The third, added 2026-09-23, is the classifier seam check: every typed file
# added in the commit declares its classifier seam, per standards/primitives.md
# Classifier Seam. A missing declaration is refused only on a typed file added
# since the base, so an earlier file is not failed for lacking the line; a
# declaration that is present, on any typed file, is held to the form.
#
# It is also cheap and quiet. It runs only when the staged set touches tools/,
# so a commit to standards/ pays nothing (the seam check runs when the staged
# set touches skills/, experts/ or tools/), and a full run over all
# fifteen tools takes about a second.
#
# wiser ships on its own. A reader who installs it and follows a path into the
# build workspace finds nothing, which is why the arrow runs one way. LICENSE
# carries "Wiser Plugins License" as a title, so the product name is not a
# pattern here; only unambiguous build-workspace paths are.
#
# The user-root homonym declared by standards/user-root.md C3 and C8 is not a
# reject. Bare "zBuilds" and "zBuilds/builds.md" are therefore not atoms.
#
# Deliberate exception: git commit --no-verify.
#
# A clone does not enable this file. Copy the tracked copy in system/hooks/
# to .git/hooks/pre-commit once per clone.
#
# The gates sit beside this hook's own directory, in ../gates, so this one copy
# checks any plugin's staged set when run from that repository's root. A copy
# in a clone's .git/hooks/ has no gates beside it and uses the clone's own
# system/gates/. Neither holds a gate a check needs: the commit is refused.

GREP=/usr/bin/grep
PATTERN='zBuilds/playbooks/gates/|zBuilds/registry\.md|zBuilds/templates/|zBuilds/repos/|wiser-builds|/Volumes'

staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
# The seam check also sees a type change (T), including a regular file
# replaced by a symlink. The checks above stay on A, C, M and R.
# core.quotePath=false: a path with a non-ASCII name, which the conventions
# allow, is printed as it is rather than quoted, so the trigger below sees it.
seam_staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRT)
[ -n "$staged" ] || [ -n "$seam_staged" ] || exit 0

# Both paths physical, so one repository spelled two ways compares equal.
ROOT=$(git rev-parse --show-toplevel) && ROOT=$(cd "$ROOT" && pwd -P) || {
  echo "pre-commit: could not name this repository's root. That is a failure" >&2
  echo "to measure and not a pass." >&2
  exit 1
}
# This hook's own file, through any symlink to it, so the gates are found
# beside the file and not beside the link.
case $0 in */*) HOOK_FILE=$0 ;; *) HOOK_FILE=./$0 ;; esac
hops=0
while [ -L "$HOOK_FILE" ]; do
  link=$(readlink "$HOOK_FILE") && [ -n "$link" ] && [ "$hops" -lt 40 ] || {
    echo "pre-commit: could not follow the link to this hook's own file, so its" >&2
    echo "gates cannot be found. That is a failure to measure and not a pass." >&2
    exit 1
  }
  case $link in /*) HOOK_FILE=$link ;; *) HOOK_FILE=${HOOK_FILE%/*}/$link ;; esac
  hops=$((hops + 1))
done
HOOK_DIR=$(cd "${HOOK_FILE%/*}" && pwd -P) || {
  echo "pre-commit: could not name this hook's own directory. That is a failure" >&2
  echo "to measure and not a pass." >&2
  exit 1
}

# The path of a gate: beside this hook where it is there, else the committing
# repository's own system/gates/.
gate_path() {
  if [ -e "$HOOK_DIR/../gates/$1" ]; then
    printf '%s\n' "$(cd "$HOOK_DIR/../gates" && pwd -P)/$1"
  else
    printf '%s\n' "$ROOT/system/gates/$1"
  fi
}

printf '%s\n' "$staged" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  git show ":$f" 2>/dev/null | $GREP -nE -- "$PATTERN" | while IFS= read -r hit; do
    # Narrow disposition for this check's own pattern-definition line, in
    # this hook's own file. Do not exempt the whole file, other lines, another
    # file, or a directory.
    rest=${hit#*:}
    if [ "$f" = system/hooks/pre-commit ] && [ "$rest" = "PATTERN='$PATTERN'" ]; then continue; fi
    printf '  %s:%s\n' "$f" "$hit"
  done
done > /tmp/.wiser-precommit-hits.$$

if [ -s /tmp/.wiser-precommit-hits.$$ ]; then
  echo "pre-commit: a build-workspace path is in the staged set." >&2
  echo "wiser ships alone; this path resolves to nothing for a reader who installs it." >&2
  echo >&2
  cat /tmp/.wiser-precommit-hits.$$ >&2
  echo >&2
  echo "Remove it, or commit with --no-verify if it is genuinely intended." >&2
  rm -f /tmp/.wiser-precommit-hits.$$
  exit 1
fi
rm -f /tmp/.wiser-precommit-hits.$$

# Every flag a tool's help declares is named in its typed file,
# per standards/script-contract.md. Only when the staged set touches tools/.
if printf '%s\n' "$staged" | $GREP -q '^tools/'; then
  GATE=$(gate_path typed-file-flags.sh)
  if [ ! -x "$GATE" ]; then
    echo "pre-commit: $GATE is missing or not executable, so the typed-file" >&2
    echo "check could not run. That is a failure to measure and not a pass." >&2
    exit 1
  fi
  # The gate measures the working tree, not the index, and says so. A staged
  # flag with an unstaged typed file will pass here and breach once committed.
  # Accepted: the alternative is materialising every tool into a temporary tree
  # to run a script against, and the window is one commit wide in a repo whose
  # tools are edited by one person at a time.
  "$GATE" "$ROOT/tools" || exit 1
fi

# Every typed file added in this commit declares its classifier seam,
# per standards/primitives.md Classifier Seam. Runs when any staged path of
# status A, C, M, R or T begins with skills/, experts/ or tools/ in any
# letter case, so a wrongly cased family path reaches the gate's own
# wrong-case detector. On an unborn branch HEAD does not resolve, and the
# base is the empty tree. Reads the index, so what is checked is what lands.
if printf '%s\n' "$seam_staged" | $GREP -q -i -E '^(skills|experts|tools)/'; then
  SEAM=$(gate_path classifier-seam.sh)
  if [ ! -f "$SEAM" ]; then
    echo "pre-commit: $SEAM is missing, so the classifier seam check could not" >&2
    echo "run. That is a failure to measure and not a pass." >&2
    exit 1
  fi
  # The gate that runs must be a gate its own repository holds. In the
  # committing repository, that is the gate being committed: an unstaged edit
  # would check the commit with a gate the commit does not carry, so ask as
  # git presents the repository to this hook, index included. In another
  # repository, it is the gate that repository has committed: tracked, and no
  # edit, staged or not. Ask it without the GIT_DIR, GIT_WORK_TREE and
  # GIT_INDEX_FILE git exports to a hook, which would point the question at
  # the committing repository.
  SEAM_TOP=$( (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
               cd "${SEAM%/*}" && top=$(git rev-parse --show-toplevel) && cd "$top" && pwd -P) 2>/dev/null ) || SEAM_TOP=
  if [ "$SEAM_TOP" = "$ROOT" ]; then
    git diff --quiet -- "${SEAM#"$ROOT"/}"
    seam_rc=$?
    seam_why="has unstaged changes, so the gate on disk is not the gate being committed. Stage or discard them first."
  elif [ -n "$SEAM_TOP" ]; then
    ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
      cd "$SEAM_TOP" || exit 2
      rel=${SEAM#"$SEAM_TOP"/}
      git ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 || exit 1
      git diff --quiet HEAD -- "$rel" )
    seam_rc=$?
    seam_why="is not the gate its own repository has committed: it is untracked there, or carries an edit, staged or not. Commit or discard it there first."
  else
    seam_rc=2
  fi
  case $seam_rc in
    0) ;;
    1)
      echo "pre-commit: $SEAM $seam_why" >&2
      exit 1 ;;
    *)
      echo "pre-commit: could not tell whether $SEAM is the gate its repository" >&2
      echo "holds. That is a failure to measure and not a pass." >&2
      exit 1 ;;
  esac
  if git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
    SEAM_BASE=HEAD
  else
    SEAM_BASE=$(git hash-object -t tree /dev/null) || {
      echo "pre-commit: could not name the empty tree, so the classifier seam" >&2
      echo "check could not run. That is a failure to measure and not a pass." >&2
      exit 1
    }
  fi
  bash "$SEAM" --tree "$ROOT" --base "$SEAM_BASE" --staged >/dev/null || {
    bash "$SEAM" --tree "$ROOT" --base "$SEAM_BASE" --staged >&2; exit 1; }
fi
exit 0
