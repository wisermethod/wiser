{
  "id": "google-apis",
  "service": "google-apis",
  "modules": {
    "insights": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_GOOGLE_APIS",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "run": {
          "description": "Run PageSpeed Insights on one public URL",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://"
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "mobile",
                  "desktop"
                ]
              },
              "category": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "performance",
                    "accessibility",
                    "best-practices",
                    "seo",
                    "pwa"
                  ]
                }
              },
              "locale": {
                "type": "string"
              },
              "audits": {
                "type": "boolean"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "translate": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_GOOGLE_APIS",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "text": {
          "description": "Translate one to 128 strings into a target language",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "text": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 128
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
              },
              "source": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "text",
                  "html"
                ]
              }
            },
            "required": [
              "text",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "voice": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_GOOGLE_APIS",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "synthesize": {
          "description": "Synthesize speech from plain text or SSML",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "ssml": {
                "type": "string",
                "minLength": 1
              },
              "language_code": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
              },
              "voice_name": {
                "type": "string",
                "minLength": 1
              },
              "gender": {
                "type": "string",
                "enum": [
                  "SSML_VOICE_GENDER_UNSPECIFIED",
                  "MALE",
                  "FEMALE",
                  "NEUTRAL"
                ]
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "MP3",
                  "LINEAR16",
                  "OGG_OPUS",
                  "MULAW",
                  "ALAW",
                  "PCM",
                  "M4A"
                ]
              },
              "speaking_rate": {
                "type": "number",
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 0.25,
                    "maximum": 2.0
                  }
                ]
              },
              "pitch": {
                "type": "number",
                "minimum": -20,
                "maximum": 20
              },
              "volume_gain_db": {
                "type": "number",
                "minimum": -96,
                "maximum": 16
              },
              "sample_rate_hertz": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "language_code",
              "encoding"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "ssml"
                ]
              }
            ]
          }
        },
        "list_voices": {
          "description": "List voices available for synthesis",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "language_code": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "speech": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_GOOGLE_APIS",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "recognize": {
          "description": "Recognize speech in audio and return a transcription",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "audio_content": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/_-]+={0,2}$"
              },
              "language_code": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$",
                "minLength": 1
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "ENCODING_UNSPECIFIED",
                  "LINEAR16",
                  "FLAC",
                  "MULAW",
                  "AMR",
                  "AMR_WB",
                  "OGG_OPUS",
                  "SPEEX_WITH_HEADER_BYTE",
                  "MP3",
                  "WEBM_OPUS",
                  "ALAW"
                ]
              },
              "sample_rate_hertz": {
                "type": "integer",
                "minimum": 8000,
                "maximum": 48000
              },
              "model": {
                "type": "string"
              },
              "max_alternatives": {
                "type": "integer",
                "minimum": 0,
                "maximum": 30
              },
              "alternative_language_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,8}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
                },
                "maxItems": 3
              },
              "enable_automatic_punctuation": {
                "type": "boolean"
              },
              "enable_word_time_offsets": {
                "type": "boolean"
              },
              "profanity_filter": {
                "type": "boolean"
              }
            },
            "required": [
              "audio_content",
              "language_code"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "language": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_GOOGLE_APIS",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "analyze": {
          "description": "Annotate text for sentiment, syntax, entities, classification, and moderation",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "PLAIN_TEXT",
                  "HTML"
                ]
              },
              "language_code": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
              },
              "encoding_type": {
                "type": "string",
                "enum": [
                  "NONE",
                  "UTF8",
                  "UTF16",
                  "UTF32"
                ]
              },
              "extract_document_sentiment": {
                "type": "boolean"
              },
              "extract_syntax": {
                "type": "boolean"
              },
              "extract_entities": {
                "type": "boolean"
              },
              "extract_entity_sentiment": {
                "type": "boolean"
              },
              "classify_text": {
                "type": "boolean"
              },
              "moderate_text": {
                "type": "boolean"
              },
              "classification_model_options": {
                "type": "object",
                "properties": {
                  "v1Model": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  },
                  "v2Model": {
                    "type": "object",
                    "properties": {
                      "contentCategoriesVersion": {
                        "type": "string",
                        "enum": [
                          "CONTENT_CATEGORIES_VERSION_UNSPECIFIED",
                          "V1",
                          "V2"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "content",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    }
  }
}
