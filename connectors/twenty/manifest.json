{
  "id": "twenty",
  "service": "twenty",
  "modules": {
    "records": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_TWENTY",
        "scheme": "API_KEY",
        "privilege": "admin"
      },
      "actions": {
        "list": {
          "description": "List one object's records. object is the plural API name and matches ^[a-z][a-zA-Z0-9]{0,62}$. limit is an integer from 1 to 60 and defaults to 20. cursor, when present, matches ^[A-Za-z0-9+/=_-]{1,512}$ and is sent as starting_after. Returns the records, pageInfo and totalCount as Twenty answers them.",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,62}$"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "default": 20
              },
              "cursor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/=_-]{1,512}$",
                "maxLength": 512
              }
            },
            "required": [
              "object"
            ],
            "additionalProperties": false
          }
        },
        "count": {
          "description": "Count one object's records. object is the plural API name and matches ^[a-z][a-zA-Z0-9]{0,62}$. Returns totalCount only; no record leaves the module.",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,62}$"
              }
            },
            "required": [
              "object"
            ],
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Create one record. object is the singular API name and matches ^[a-z][a-zA-Z0-9]{0,62}$. data holds at most 100 field values, and each of its keys matches that same pattern. The values travel only as GraphQL variables. Returns the new record's id. A record this action creates can start the workspace's own workflows, and such a workflow may send email. This action sends none.",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,62}$"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-zA-Z0-9]{0,62}$"
                },
                "maxProperties": 100
              }
            },
            "required": [
              "object",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "workspace": {
          "description": "Read the workspace the bound key belongs to. Takes an empty object. Returns id, subdomain and displayName. A caller checks it before writing, on each module it uses, since each module can be bound to its own account.",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "metadata": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_TWENTY",
        "scheme": "API_KEY",
        "privilege": "admin"
      },
      "actions": {
        "list_objects": {
          "description": "List the workspace's objects and their fields. Takes an empty object. Each object includes id, nameSingular, namePlural, labelSingular, labelPlural, isCustom and isActive, and each field includes id, name, label, type, isCustom, isActive and options. A workspace with more than 200 objects, or an object with more than 200 fields, is refused as vendor_error with code RESULT_INCOMPLETE rather than returned in part.",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "workspace": {
          "description": "Read the workspace the bound key belongs to. Takes an empty object. Returns id, subdomain and displayName. A caller checks it before writing, on each module it uses, since each module can be bound to its own account.",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "create_object": {
          "description": "Create one object. nameSingular and namePlural match ^[a-z][a-zA-Z0-9]{0,62}$ and must differ from each other. namePlural publishes that same language as ^[a-z](?:[a-zA-Z0-9]{0,62})$. labelSingular and labelPlural are 1 to 63 code points. icon, when present, matches ^Icon[A-Za-z0-9]{1,60}$. description, when present, is at most 500 code points. A label counted in emoji can pass this check and still be refused by Twenty, which counts UTF-16 units.",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "nameSingular": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,62}$",
                "minLength": 1,
                "maxLength": 63
              },
              "namePlural": {
                "type": "string",
                "pattern": "^[a-z](?:[a-zA-Z0-9]{0,62})$",
                "minLength": 1,
                "maxLength": 63
              },
              "labelSingular": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "labelPlural": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "icon": {
                "type": "string",
                "pattern": "^Icon[A-Za-z0-9]{1,60}$",
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "nameSingular",
              "namePlural",
              "labelSingular",
              "labelPlural"
            ],
            "additionalProperties": false
          }
        },
        "create_field": {
          "description": "Create one field. objectMetadataId is a lowercase UUID. name matches ^[a-z][a-zA-Z0-9]{0,62}$. label is 1 to 63 code points. type is TEXT, NUMBER, BOOLEAN, DATE, DATE_TIME, SELECT or MULTI_SELECT. description, when present, is at most 500 code points. options is required for SELECT and MULTI_SELECT and refused for every other type. Each option has a label of 1 to 63 code points with no comma, a value unique within the list that matches ^(?!.*__)[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$ and is at most 63 characters, and a color from the 25 tag colours. The module sets position from the order. A label counted in emoji can pass this check and still be refused by Twenty, which counts UTF-16 units.",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "objectMetadataId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,62}$",
                "minLength": 1,
                "maxLength": 63
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "type": {
                "type": "string",
                "enum": [
                  "TEXT",
                  "NUMBER",
                  "BOOLEAN",
                  "DATE",
                  "DATE_TIME",
                  "SELECT",
                  "MULTI_SELECT"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "pattern": "^[^,]+$",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^(?!.*__)[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "color": {
                      "type": "string",
                      "enum": [
                        "red",
                        "ruby",
                        "crimson",
                        "tomato",
                        "orange",
                        "amber",
                        "yellow",
                        "lime",
                        "grass",
                        "green",
                        "jade",
                        "mint",
                        "turquoise",
                        "cyan",
                        "sky",
                        "blue",
                        "iris",
                        "violet",
                        "purple",
                        "plum",
                        "pink",
                        "bronze",
                        "gold",
                        "brown",
                        "gray"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "value",
                    "color"
                  ]
                }
              }
            },
            "required": [
              "objectMetadataId",
              "name",
              "label",
              "type"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "enum": [
                      "TEXT",
                      "NUMBER",
                      "BOOLEAN",
                      "DATE",
                      "DATE_TIME"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "not": {
                  "required": [
                    "options"
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "SELECT",
                      "MULTI_SELECT"
                    ]
                  }
                },
                "required": [
                  "type",
                  "options"
                ]
              }
            ]
          }
        },
        "add_field_options": {
          "description": "Append options to one SELECT or MULTI_SELECT field. fieldId is a lowercase UUID. options is 1 to 50 new items of the same shape as create_field, and each value is unique within that list. The module reads the field first. It refuses a type other than SELECT or MULTI_SELECT, a value or a label already on the field, and a combined list that would pass 100 options. It then sends the existing options unchanged and in order, followed by the new ones, with positions continuing above the highest existing position. It does not remove, rename or reorder an option. A label counted in emoji can pass this check and still be refused by Twenty, which counts UTF-16 units. It reads and then writes the whole list, and Twenty offers no conditional update, so no one else may change this field's options while it runs: an option another caller adds in between is lost.",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "fieldId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "pattern": "^[^,]+$",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^(?!.*__)[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "color": {
                      "type": "string",
                      "enum": [
                        "red",
                        "ruby",
                        "crimson",
                        "tomato",
                        "orange",
                        "amber",
                        "yellow",
                        "lime",
                        "grass",
                        "green",
                        "jade",
                        "mint",
                        "turquoise",
                        "cyan",
                        "sky",
                        "blue",
                        "iris",
                        "violet",
                        "purple",
                        "plum",
                        "pink",
                        "bronze",
                        "gold",
                        "brown",
                        "gray"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "value",
                    "color"
                  ]
                }
              }
            },
            "required": [
              "fieldId",
              "options"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    }
  }
}
