{
  "id": "x",
  "service": "x",
  "modules": {
    "account": {
      "auth": {
        "provider": "catalog",
        "toolkit": "TWITTER",
        "scheme": "OAUTH2",
        "privilege": "write"
      },
      "actions": {
        "me": {
          "description": "Read the connected X account",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        "get_post": {
          "description": "Read one X post by id",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "post_id": {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            },
            "required": [
              "post_id"
            ],
            "additionalProperties": false
          }
        },
        "recent_posts": {
          "description": "Read only the connected account's recent posts; max_results defaults to 5 and is limited to 5 through 10. The first users/me answer must have a data.id matching ^[0-9]{1,19}$ before the posts request is made",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "max_results": {
                "type": "integer",
                "minimum": 5,
                "maximum": 10
              }
            },
            "additionalProperties": false
          }
        },
        "delete_post": {
          "description": "Delete one X post by id",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "post_id": {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            },
            "required": [
              "post_id"
            ],
            "additionalProperties": false
          }
        },
        "create_post": {
          "description": "Publish one X post or reply. Text is limited to 280 code points and connector weight 280: code points 0 to 4351, 8192 to 8205, 8208 to 8223 and 8242 to 8247 weigh 1, all others weigh 2, with no shorter URL weighting. This conservative cap is not a measured copy of X's rule. A detected URL (a scheme followed by ://, www., or a dotted host whose last label is two or more letters) requires allow_url=true as a format rule, not a cost bound; X's detector is unpublished and may differ",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280,
                "pattern": "\\S"
              },
              "reply_to": {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              },
              "allow_url": {
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    }
  }
}
