{
  "id": "google-ai",
  "service": "google-ai",
  "modules": {
    "translate": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_GOOGLE_AI",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "text": {
          "description": "Translate one to 128 strings into a target language",
          "risk": "medium",
          "confirmation": "once",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "text": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 128
              },
              "target": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "text",
                  "html"
                ]
              }
            },
            "required": [
              "text",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    }
  }
}
