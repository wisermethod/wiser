{
  "id": "hubspot",
  "service": "hubspot",
  "modules": {
    "crm": {
      "auth": {
        "provider": "catalog",
        "toolkit": "HUBSPOT",
        "scheme": "OAUTH2",
        "privilege": "read"
      },
      "actions": {
        "get_contact": {
          "description": "get contact",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "contact_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "archived": {
                "type": "boolean"
              },
              "properties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "associations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "contact_id"
            ],
            "additionalProperties": false
          }
        },
        "search_contacts": {
          "description": "search contacts",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              },
              "after": {
                "type": "string"
              },
              "properties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "filter_groups": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
