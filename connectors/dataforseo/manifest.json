    "backlinks": {
      "auth": {
        "provider": "catalog",
        "toolkit": "DATAFORSEO",
        "scheme": "BASIC",
        "privilege": "write"
      },
      "actions": {
        "summary": {
          "description": "Backlink summary for a target; $0.024 per call plus $0.000036 per row",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "include_subdomains": { "type": "boolean" },
              "backlinks_status_type": { "type": "string", "enum": ["all", "live", "lost"] }
            },
            "required": ["target"],
            "additionalProperties": false
          }
        },
        "referring_domains": {
          "description": "Referring domains for a target; $0.024 per call plus $0.000036 per row",
          "risk": "medium",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
