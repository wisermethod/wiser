              "location_code": {
                "type": "integer"
              },
              "location_name": {
                "type": "string"
              },
              "language_code": {
                "type": "string"
              },
              "language_name": {
                "type": "string"
              },
              "device": {
                "type": "string",
                "enum": [
                  "desktop",
                  "mobile"
                ]
              },
              "depth": {
                "type": "integer",
                "minimum": 10,
                "maximum": 200,
                "multipleOf": 10
              }
            },
            "required": [
              "keyword"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "location_code",
                  "language_code"
                ]
              },
              {
                "required": [
                  "location_code",
                  "language_name"
                ]
              },
              {
                "required": [
                  "location_name",
                  "language_code"
                ]
              },
              {
                "required": [
                  "location_name",
                  "language_name"
                ]
