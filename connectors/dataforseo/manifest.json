              "target": { "type": "string", "minLength": 1 },
              "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "offset": { "type": "integer", "minimum": 0 },
              "filters": { "type": "array" },
              "order_by": {
                "type": "array",
                "maxItems": 3,
