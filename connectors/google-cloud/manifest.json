{
  "id": "google-cloud",
  "service": "google-cloud",
  "modules": {
    "projects": {
      "auth": {
        "provider": "catalog",
        "toolkit": "GOOGLEBIGQUERY",
        "scheme": "OAUTH2",
        "privilege": "read"
      },
      "actions": {
        "get": {
          "description": "Read one Google Cloud project by project id",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              }
            },
            "required": [
              "project"
            ],
            "additionalProperties": false
          }
        },
        "search": {
          "description": "Search Google Cloud projects the grant can reach",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "page_size": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "page_token": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "get_iam_policy": {
          "description": "Read IAM policy for a named Google Cloud project",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "requested_policy_version": {
                "type": "integer",
                "enum": [
                  0,
                  1,
                  3
                ]
              }
            },
            "required": [
              "project"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "services": {
      "auth": {
        "provider": "catalog",
        "toolkit": "GOOGLEBIGQUERY",
        "scheme": "OAUTH2",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List services on a named Google Cloud project; filter such as state:ENABLED limits the vendor's default of every known service",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "filter": {
                "type": "string"
              },
              "page_size": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "page_token": {
                "type": "string"
              }
            },
            "required": [
              "project"
            ],
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Read one service on a named Google Cloud project",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "service": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/]+$"
              }
            },
            "required": [
              "project",
              "service"
            ],
            "additionalProperties": false
          }
        },
        "enable": {
          "description": "Enable the named service on the named Google Cloud project",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "service": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/]+$"
              }
            },
            "required": [
              "project",
              "service"
            ],
            "additionalProperties": false
          }
        },
        "get_operation": {
          "description": "Read a Service Usage long-running operation",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "operation_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^operations/[^/]+$"
              }
            },
            "required": [
              "operation_name"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "keys": {
      "auth": {
        "provider": "catalog",
        "toolkit": "GOOGLEBIGQUERY",
        "scheme": "OAUTH2",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List API keys on a named Google Cloud project",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "page_size": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "page_token": {
                "type": "string"
              },
              "show_deleted": {
                "type": "boolean"
              }
            },
            "required": [
              "project"
            ],
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Read one API key on a named Google Cloud project, without key material",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "key_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/]+$"
              }
            },
            "required": [
              "project",
              "key_id"
            ],
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Create a restricted API key on the named Google Cloud project",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "key_id": {
                "type": "string",
                "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
                "maxLength": 63
              },
              "display_name": {
                "type": "string",
                "maxLength": 63
              },
              "restrictions": {
                "type": "object",
                "properties": {
                  "api_targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\s/]+$"
                        },
                        "methods": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "service"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "api_targets"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "project",
              "restrictions"
            ],
            "additionalProperties": false
          }
        },
        "patch": {
          "description": "Patch restrictions on the named API key in the named Google Cloud project",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{1,19})$"
              },
              "key_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/]+$"
              },
              "restrictions": {
                "type": "object",
                "properties": {
                  "api_targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\s/]+$"
                        },
                        "methods": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "service"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "api_targets"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "project",
              "key_id",
              "restrictions"
            ],
            "additionalProperties": false
          }
        },
        "get_operation": {
          "description": "Read an API Keys long-running operation, without key material",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "operation_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^operations/[^/]+$"
              }
            },
            "required": [
              "operation_name"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    }
  }
}
