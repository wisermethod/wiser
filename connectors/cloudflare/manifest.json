{
  "id": "cloudflare",
  "service": "cloudflare",
  "modules": {
    "dns": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_records": {
          "description": "List DNS records in a zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "get_record": {
          "description": "Get one DNS record",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "create_record": {
          "description": "Create a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" },
              "priority": { "type": "integer" }
            },
            "required": ["zone_id", "type", "name", "content"],
            "additionalProperties": false
          }
        },
        "update_record": {
          "description": "Update a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "delete_record": {
          "description": "Delete a DNS record",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "export_zone": {
          "description": "Export a zone as a BIND file",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "import_zone": {
          "description": "Import a BIND zone file",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "zone_file": { "type": "string" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "zone_file"],
            "additionalProperties": false
          }
        },
        "batch": {
          "description": "Batch delete, patch, put, and post DNS records",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "deletes": { "type": "array" },
              "patches": { "type": "array" },
              "puts": { "type": "array" },
              "posts": { "type": "array" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "zones": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List every zone the connected token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "account_id": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Get one zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "list_accounts": {
          "description": "List Cloudflare accounts the token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Create a zone",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "account_id": { "type": "string" },
              "type": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "delete": {
          "description": "Delete a zone",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "pages": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_projects": {
          "description": "List Pages projects in an account",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" }
            },
            "required": ["account_id"],
            "additionalProperties": false
          }
        },
        "get_project": {
          "description": "Get one Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "list_deployments": {
          "description": "List deployments for a Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "create_project": {
          "description": "Create a Pages project. name is lowercase letters, digits, and hyphens, 1 to 58 characters, with no leading or trailing hyphen.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "production_branch": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "name", "production_branch"],
            "additionalProperties": false
          }
        },
        "add_domain": {
          "description": "Attach a domain to a Pages project. This does not create the DNS CNAME record. The domain stays pending until that record exists. The record is Zone Publisher's job.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": { "type": "string", "minLength": 1 },
              "domain": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "domain"],
            "additionalProperties": false
          }
        },
        "remove_domain": {
          "description": "Detach a custom domain from a Pages project. The DNS record is left in place; removing it is Zone Publisher's job.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "domain": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
              }
            },
            "required": ["account_id", "project_name", "domain"],
            "additionalProperties": false
          }
        },
        "delete_project": {
          "description": "Delete a Pages project and every deployment in it. Reads the project first and refuses while any domain other than its own pages.dev subdomain is attached, and when the read carries no domain list; remove_domain comes first. Best effort: a domain attached between the read and the delete is not caught. Cloudflare may refuse a project with many deployments.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "deploy": {
          "description": "Deploy static kit output to Pages production by Direct Upload. Replaces what production serves. dir must be a directory named dist whose parent directory is named site and contains a regular file kit.json, and neither site nor dist may be a symbolic link. Refuses the user-config credential directory, the home directory, a tree whose root contains _worker.js or a functions directory, more than 20000 files, any file over 25 MiB, and a file that changes between hashing and upload. Skips node_modules, hidden names other than .well-known, names shaped like private keys or certificate bundles, .env files, _routes.json, and links that resolve outside dir, and lists every skip in the result. _headers and _redirects are sent with the deployment and are not assets. The upload token rides the proxy as an Authorization header on the asset calls, verified live 2026-09-25.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": { "type": "string", "minLength": 1 },
              "dir": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "dir"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "rulesets": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "create": {
          "description": "Create a ruleset",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "kind": { "type": "string" },
              "name": { "type": "string" },
              "phase": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "kind", "name", "phase"],
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Get a ruleset",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "account_id": { "type": "string" },
              "zone_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "ruleset_id"],
            "additionalProperties": false
          }
        },
        "delete": {
          "description": "Delete a ruleset",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "ruleset_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "ruleset_id"],
            "additionalProperties": false
          }
        },
        "add_rule": {
          "description": "Add a rule to a ruleset",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "rule": { "type": "object" },
              "account_id": { "type": "string" },
              "zone_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "ruleset_id", "rule"],
            "additionalProperties": false
          }
        },
        "remove_rule": {
          "description": "Remove a rule from a ruleset",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "rule_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "ruleset_id", "rule_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
