{
  "id": "cloudflare",
  "service": "cloudflare",
  "modules": {
    "dns": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_records": {
          "description": "List DNS records in a zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "get_record": {
          "description": "Get one DNS record",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "create_record": {
          "description": "Create a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" },
              "priority": { "type": "integer" }
            },
            "required": ["zone_id", "type", "name", "content"],
            "additionalProperties": false
          }
        },
        "update_record": {
          "description": "Update a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "delete_record": {
          "description": "Delete a DNS record",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "export_zone": {
          "description": "Export a zone as a BIND file",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "import_zone": {
          "description": "Import a BIND zone file",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "zone_file": { "type": "string" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "zone_file"],
            "additionalProperties": false
          }
        },
        "batch": {
          "description": "Batch delete, patch, put, and post DNS records",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "deletes": { "type": "array" },
              "patches": { "type": "array" },
              "puts": { "type": "array" },
              "posts": { "type": "array" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "zones": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List every zone the connected token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "account_id": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Get one zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "list_accounts": {
          "description": "List Cloudflare accounts the token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Create a zone",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "account_id": { "type": "string" },
              "type": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "delete": {
          "description": "Delete a zone",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "pages": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_projects": {
          "description": "List Pages projects in an account",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" }
            },
            "required": ["account_id"],
            "additionalProperties": false
          }
        },
        "get_project": {
          "description": "Get one Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "list_deployments": {
          "description": "List deployments for a Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "create_project": {
          "description": "Create a Pages project. name is lowercase letters, digits, and hyphens, 1 to 58 characters, with no leading or trailing hyphen.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "production_branch": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "name", "production_branch"],
            "additionalProperties": false
          }
        },
        "add_domain": {
          "description": "Attach a domain to a Pages project. This does not create the DNS CNAME record. The domain stays pending until that record exists. The record is Zone Publisher's job.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": { "type": "string", "minLength": 1 },
              "domain": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "domain"],
            "additionalProperties": false
          }
        },
        "remove_domain": {
          "description": "Detach a custom domain from a Pages project. The DNS record is left in place; removing it is Zone Publisher's job.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "domain": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
              }
            },
            "required": ["account_id", "project_name", "domain"],
            "additionalProperties": false
          }
        },
        "delete_project": {
          "description": "Delete a Pages project and every deployment in it. Reads the project first and refuses while any domain other than its own pages.dev subdomain is attached, and when the read carries no domain list; remove_domain comes first. Best effort: a domain attached between the read and the delete is not caught. Cloudflare may refuse a project with many deployments.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "deploy": {
          "description": "Deploy static kit output to Pages production by Direct Upload. Replaces what production serves. dir must be a directory named dist whose parent directory is named site and contains a regular file kit.json, and neither site nor dist may be a symbolic link. Refuses the user-config credential directory, the home directory, a tree whose root contains _worker.js or a functions directory, more than 20000 files, any file over 25 MiB, any file whose upload request alone would exceed 3 MiB (about 2.25 MiB on disk), and a file that changes between hashing and upload. Skips node_modules, hidden names other than .well-known, names shaped like private keys or certificate bundles, .env files, _routes.json, and links that resolve outside dir, and lists every skip in the result. _headers and _redirects are sent with the deployment and are not assets. The upload token rides the proxy as an Authorization header on the asset calls, verified live 2026-09-25. A kit payload may carry the kit's Function from site/dist-function/, the sibling of dir, only when that directory exists. It must be a real directory, not a link, holding exactly the regular files _worker.js, _routes.json, schedule.bin and function.json. Any other entry, including a hidden name, a folder or a link, refuses the deploy before any call. _worker.js is admitted only when its sha256 is listed in kit-function.json beside this connector; a missing or malformed list refuses every such deploy. function.json must name those three files' sha256, the kitVersion of that listed fingerprint and of site/kit.json, and the buildTime string recorded in site/.astro/kit-build.json. _routes.json is version 1 with only include and exclude, at most 100 rules, each starting with / and at most 100 characters. schedule.bin must start with WKS1 and a JSON header whose v is 1; nothing else in it is interpreted. The connector builds the Worker bundle: metadata naming _worker.js as main_module with no bindings, _worker.js as application/javascript+module, and schedule.bin as application/octet-stream. The bundle stays within 2 MiB. The deployment request stays within the same base64 cap as deploy_with_functions, and over that cap the deploy is refused before any call and names how many scheduled instants the Function carries. The four files are re-read before the deployment is created. Nothing under dist-function/ is an asset, and functions-filepath-routing-config.json is not sent. When dist-function/ is absent the deploy is unchanged and the result's function is null; when it is present, function reports the kit version, the fingerprint, the schedule size, the route-rule counts, and what was carried.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": { "type": "string", "minLength": 1 },
              "dir": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "dir"],
            "additionalProperties": false
          }
        },
        "bind_d1": {
          "description": "Bind one D1 database onto a Pages project under one binding name. This can overwrite a binding of the same name. environments names production, preview, or both, and defaults to both when omitted. Duplicates are refused. The patch contains only the named environments and only that binding. collateral_changes lists the names of other settings the patch changed, never their values. A failed bind still reports collateral_changes.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "binding": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "environments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": { "type": "string", "enum": ["production", "preview"] }
              }
            },
            "required": ["account_id", "project_name", "binding", "database_id"],
            "additionalProperties": false
          }
        },
        "deploy_with_functions": {
          "description": "Deploy static build output that is not a kit site, plus a Pages Functions bundle, to production by Direct Upload. Runs on the local gateway only. dir and functions_build are absolute paths in the platform's normal form, with no . or .. or repeated separator (on Windows, no /) and no symbolic link anywhere in their spelling. dir is not the home directory, not the credential directory, not the filesystem root, and not a kit payload (a site/dist, any directory whose parent holds kit.json, or any directory inside a kit's dist, which go through cloudflare.pages.deploy). Its root must not contain functions, _worker.js, _worker.bundle, functions-filepath-routing-config.json, package.json, wrangler.toml, wrangler.json, or wrangler.jsonc, in any letter case; _worker.js, _worker.bundle or functions-filepath-routing-config.json anywhere below it stops the deploy, and package.json, package-lock.json or a wrangler config below its root is skipped and listed. functions_build is a separate absolute directory, not inside dir and not containing dir, whose entries are exactly the regular files _worker.bundle, _routes.json, functions-filepath-routing-config.json and build.json. build.json is a JSON object whose assets is dir, whose functions names by its real path a functions source outside dir, and whose sources lists each source file's sha256; a file in dir with a listed source's bytes stops the deploy. It is returned as provenance and never sent. The bundle is at most 2 MiB and must parse strictly as multipart: each part carries only Content-Disposition (form-data, a quoted name and an optional quoted filename equal to it) and Content-Type, each once, and part names are unique and plain ASCII (letters, digits, . _ - /); one metadata part of JSON naming a main_module part, with bindings absent or an empty array; module parts typed as Wrangler types modules. The bundle sent is rebuilt from what was screened. Bindings come from the project through cloudflare.pages.bind_d1, not from the bundle. _routes.json is version 1, include is a non-empty array of strings, exclude is an array of strings, together at most 100 rules, and every rule starts with /. functions-filepath-routing-config.json is a JSON object with a routes array. The deployment request is refused when its base64 length exceeds 3 MiB. A file that changes between screening and creation stops the deploy. The static walk applies the same screens as pages.deploy and lists every skip.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "dir": { "type": "string", "minLength": 1 },
              "functions_build": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "dir", "functions_build"],
            "additionalProperties": false
          }
        },
        "d1_list_databases": {
          "description": "List D1 databases in an account. name filters by database name. page, when given, is an integer of 1 or more. per_page, when given, is an integer from 1 to 10000.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "name": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 },
              "per_page": { "type": "integer", "minimum": 1, "maximum": 10000 }
            },
            "required": ["account_id"],
            "additionalProperties": false
          }
        },
        "d1_get_database": {
          "description": "Get one D1 database.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": ["account_id", "database_id"],
            "additionalProperties": false
          }
        },
        "d1_create_database": {
          "description": "Create a D1 database. name is required. primary_location_hint, when given, is one of wnam, enam, weur, eeur, apac, oc.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "name": { "type": "string", "minLength": 1 },
              "primary_location_hint": {
                "type": "string",
                "enum": ["wnam", "enam", "weur", "eeur", "apac", "oc"]
              }
            },
            "required": ["account_id", "name"],
            "additionalProperties": false
          }
        },
        "d1_query": {
          "description": "Run one read-only D1 query and return the vendor envelope. After leading whitespace, sql must open with SELECT followed by a character that is not a letter, digit, underscore or semicolon, and it may contain no semicolon except an optional one as the last non-whitespace character; the published pattern is that rule. D1 splits statements on semicolons with no regard for string literals, so the semicolon rule is absolute. sql is at most 100000 code points. params, when given, is an array of at most 100 strings. A statement that is not that single SELECT is refused; use cloudflare.pages.d1_execute.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sql": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000,
                "pattern": "^\\s*[Ss][Ee][Ll][Ee][Cc][Tt][^A-Za-z0-9_;][^;]*(?:;\\s*)?$"
              },
              "params": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string" }
              }
            },
            "required": ["account_id", "database_id", "sql"],
            "additionalProperties": false
          }
        },
        "d1_execute": {
          "description": "Run D1 SQL that is not limited to a single SELECT and return the vendor envelope. sql is at most 100000 code points. params, when given, is an array of at most 100 strings. D1 splits statements on semicolons with no regard for string literals.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sql": { "type": "string", "minLength": 1, "maxLength": 100000 },
              "params": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string" }
              }
            },
            "required": ["account_id", "database_id", "sql"],
            "additionalProperties": false
          }
        },
        "d1_apply_migration": {
          "description": "Read one local .sql file and apply it on the local gateway only. Records a Wrangler-compatible d1_migrations row under the file's basename. A name already recorded is reported already_applied and nothing else runs. D1 splits on semicolons, so a semicolon inside a string literal or a trigger body is split too. Whether a failed statement rolls back earlier ones is D1's and is not promised. A file over 1 MiB (1048576 bytes) is refused; apply it with Wrangler: wrangler d1 migrations apply. The path must be absolute, must not contain a symbolic link, and must not be a credential file.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "file": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "database_id", "file"],
            "additionalProperties": false
          }
        },
        "d1_delete_database": {
          "description": "Delete a D1 database and the data in it.",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": ["account_id", "database_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
