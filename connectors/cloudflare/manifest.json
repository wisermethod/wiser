{
  "id": "cloudflare",
  "service": "cloudflare",
  "modules": {
    "dns": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_records": {
          "description": "List DNS records in a zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "required": ["zone_id"]
          }
        },
        "get_record": {
          "description": "Get one DNS record",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"]
          }
        },
        "create_record": {
          "description": "Create a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" },
              "priority": { "type": "integer" }
            },
            "required": ["zone_id", "type", "name", "content"]
          }
        },
        "update_record": {
          "description": "Update a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "record_id"]
          }
        },
        "delete_record": {
          "description": "Delete a DNS record",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"]
          }
        },
        "export_zone": {
          "description": "Export a zone as a BIND file",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"]
          }
        },
        "import_zone": {
          "description": "Import a BIND zone file",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "zone_file": { "type": "string" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "zone_file"]
          }
        },
        "batch": {
          "description": "Batch delete, patch, put, and post DNS records",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "deletes": { "type": "array" },
              "patches": { "type": "array" },
              "puts": { "type": "array" },
              "posts": { "type": "array" }
            },
            "required": ["zone_id"]
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "zones": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List every zone the connected token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "account_id": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            }
          }
        },
        "get": {
          "description": "Get one zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"]
          }
        },
        "list_accounts": {
          "description": "List Cloudflare accounts the token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            }
          }
        },
        "create": {
          "description": "Create a zone",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "account_id": { "type": "string" },
              "type": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "delete": {
          "description": "Delete a zone",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"]
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "pages": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_projects": {
          "description": "List Pages projects in an account",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" }
            },
            "required": ["account_id"]
          }
        },
        "get_project": {
          "description": "Get one Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"]
          }
        },
        "list_deployments": {
          "description": "List deployments for a Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"]
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "rulesets": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "create": {
          "description": "Create a ruleset",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "kind": { "type": "string" },
              "name": { "type": "string" },
              "phase": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "kind", "name", "phase"]
          }
        },
        "get": {
          "description": "Get a ruleset",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "account_id": { "type": "string" },
              "zone_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "ruleset_id"]
          }
        },
        "delete": {
          "description": "Delete a ruleset",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "ruleset_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "ruleset_id"]
          }
        },
        "add_rule": {
          "description": "Add a rule to a ruleset",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "rule": { "type": "object" },
              "account_id": { "type": "string" },
              "zone_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "ruleset_id", "rule"]
          }
        },
        "remove_rule": {
          "description": "Remove a rule from a ruleset",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "rule_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "ruleset_id", "rule_id"]
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
