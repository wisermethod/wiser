{
  "id": "cloudflare",
  "service": "cloudflare",
  "modules": {
    "dns": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_records": {
          "description": "List DNS records in a zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "get_record": {
          "description": "Get one DNS record",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "create_record": {
          "description": "Create a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" },
              "priority": { "type": "integer" }
            },
            "required": ["zone_id", "type", "name", "content"],
            "additionalProperties": false
          }
        },
        "update_record": {
          "description": "Update a DNS record",
          "risk": "medium",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" },
              "ttl": { "type": "integer" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "delete_record": {
          "description": "Delete a DNS record",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "record_id": { "type": "string" }
            },
            "required": ["zone_id", "record_id"],
            "additionalProperties": false
          }
        },
        "export_zone": {
          "description": "Export a zone as a BIND file",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "import_zone": {
          "description": "Import a BIND zone file",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "zone_file": { "type": "string" },
              "proxied": { "type": "boolean" }
            },
            "required": ["zone_id", "zone_file"],
            "additionalProperties": false
          }
        },
        "batch": {
          "description": "Batch delete, patch, put, and post DNS records",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" },
              "deletes": { "type": "array" },
              "patches": { "type": "array" },
              "puts": { "type": "array" },
              "posts": { "type": "array" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "zones": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List every zone the connected token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "account_id": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Get one zone",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        },
        "list_accounts": {
          "description": "List Cloudflare accounts the token can see",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "page": { "type": "integer" },
              "per_page": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Create a zone",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "account_id": { "type": "string" },
              "type": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "delete": {
          "description": "Delete a zone",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "zone_id": { "type": "string" }
            },
            "required": ["zone_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "pages": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_projects": {
          "description": "List Pages projects in an account",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" }
            },
            "required": ["account_id"],
            "additionalProperties": false
          }
        },
        "get_project": {
          "description": "Get one Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "list_deployments": {
          "description": "List deployments for a Pages project",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "project_name": { "type": "string" }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "create_project": {
          "description": "Create a Pages project. name is lowercase letters, digits, and hyphens, 1 to 58 characters, with no leading or trailing hyphen.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "production_branch": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "name", "production_branch"],
            "additionalProperties": false
          }
        },
        "add_domain": {
          "description": "Attach a domain to a Pages project. This does not create the DNS CNAME record. The domain stays pending until that record exists. The record is Zone Publisher's job.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": { "type": "string", "minLength": 1 },
              "domain": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "domain"],
            "additionalProperties": false
          }
        },
        "remove_domain": {
          "description": "Detach a custom domain from a Pages project. The DNS record is left in place; removing it is Zone Publisher's job.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "domain": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
              }
            },
            "required": ["account_id", "project_name", "domain"],
            "additionalProperties": false
          }
        },
        "delete_project": {
          "description": "Delete a Pages project and every deployment in it. Reads the project first and refuses while any domain other than its own pages.dev subdomain is attached, and when the read carries no domain list; remove_domain comes first. Best effort: a domain attached between the read and the delete is not caught. Cloudflare may refuse a project with many deployments.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              }
            },
            "required": ["account_id", "project_name"],
            "additionalProperties": false
          }
        },
        "deploy": {
          "description": "Deploy static kit output to Pages production by Direct Upload. Replaces what production serves. dir must be a directory named dist whose parent directory is named site and contains a regular file kit.json, and neither site nor dist may be a symbolic link. Refuses the user-config credential directory, the home directory, a tree whose root contains _worker.js or a functions directory, more than 20000 files, any file over 25 MiB, any file whose upload request alone would exceed 3 MiB (about 2.25 MiB on disk), and a file that changes between hashing and upload. Skips node_modules, hidden names other than .well-known, names shaped like private keys or certificate bundles, .env files, _routes.json, and links that resolve outside dir, and lists every skip in the result. _headers and _redirects are sent with the deployment and are not assets. The upload token rides the proxy as an Authorization header on the asset calls, verified live 2026-09-25.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "project_name": { "type": "string", "minLength": 1 },
              "dir": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "dir"],
            "additionalProperties": false
          }
        },
        "bind_d1": {
          "description": "Bind one D1 database onto a Pages project under one binding name. This can overwrite a binding of the same name. environments names production, preview, or both, and defaults to both when omitted. Duplicates are refused. The patch contains only the named environments and only that binding. collateral_changes lists the names of other settings the patch changed, never their values.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "binding": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "environments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": { "type": "string", "enum": ["production", "preview"] }
              }
            },
            "required": ["account_id", "project_name", "binding", "database_id"],
            "additionalProperties": false
          }
        },
        "deploy_with_functions": {
          "description": "Deploy static build output that is not a kit site, plus a Pages Functions bundle, to production by Direct Upload. Runs on the local gateway only. dir is an absolute directory that is not the home directory, not the credential directory, and not the filesystem root, and its root must not contain functions, _worker.js, _worker.bundle, functions-filepath-routing-config.json, package.json, wrangler.toml, wrangler.json, or wrangler.jsonc, in any letter case. functions_build is a separate absolute directory, not inside dir and not containing dir, whose entries are the regular files _worker.bundle, _routes.json, and functions-filepath-routing-config.json, plus an optional build.json. The bundle is at most 2 MiB and must parse as multipart with one metadata part, a main_module part, and bindings either absent or an empty array. Bindings come from the project through cloudflare.pages.bind_d1, not from the bundle. _routes.json is version 1, include is a non-empty array of strings, exclude is an array of strings, together at most 100 rules, and every rule starts with /. The deployment request is refused when its base64 length exceeds 3 MiB. A file that changes between screening and creation stops the deploy. The static walk applies the same screens as pages.deploy and lists every skip.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "project_name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,56}[a-z0-9])?$"
              },
              "dir": { "type": "string", "minLength": 1 },
              "functions_build": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "project_name", "dir", "functions_build"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "d1": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_databases": {
          "description": "List D1 databases in an account. name filters by database name. page, when given, is an integer of 1 or more. per_page, when given, is an integer from 1 to 10000.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "name": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 },
              "per_page": { "type": "integer", "minimum": 1, "maximum": 10000 }
            },
            "required": ["account_id"],
            "additionalProperties": false
          }
        },
        "get_database": {
          "description": "Get one D1 database.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": ["account_id", "database_id"],
            "additionalProperties": false
          }
        },
        "create_database": {
          "description": "Create a D1 database. name is required. primary_location_hint, when given, is one of wnam, enam, weur, eeur, apac, oc.",
          "risk": "medium",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "name": { "type": "string", "minLength": 1 },
              "primary_location_hint": {
                "type": "string",
                "enum": ["wnam", "enam", "weur", "eeur", "apac", "oc"]
              }
            },
            "required": ["account_id", "name"],
            "additionalProperties": false
          }
        },
        "query": {
          "description": "Run one read-only D1 query and return the vendor envelope. After leading whitespace, sql must open with SELECT followed by a character that is not a letter, digit, underscore or semicolon, and it may contain no semicolon except an optional one as the last non-whitespace character; the published pattern is that rule. D1 splits statements on semicolons with no regard for string literals, so the semicolon rule is absolute. sql is at most 100000 code points. params, when given, is an array of at most 100 strings. A statement that is not that single SELECT is refused; use cloudflare.d1.execute.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sql": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000,
                "pattern": "^\\s*[Ss][Ee][Ll][Ee][Cc][Tt][^A-Za-z0-9_;][^;]*(?:;\\s*)?$"
              },
              "params": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string" }
              }
            },
            "required": ["account_id", "database_id", "sql"],
            "additionalProperties": false
          }
        },
        "execute": {
          "description": "Run D1 SQL that is not limited to a single SELECT and return the vendor envelope. sql is at most 100000 code points. params, when given, is an array of at most 100 strings. D1 splits statements on semicolons with no regard for string literals.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sql": { "type": "string", "minLength": 1, "maxLength": 100000 },
              "params": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string" }
              }
            },
            "required": ["account_id", "database_id", "sql"],
            "additionalProperties": false
          }
        },
        "apply_migration": {
          "description": "Read one local .sql file and apply it on the local gateway only. Records a Wrangler-compatible d1_migrations row under the file's basename. A name already recorded is reported already_applied and nothing else runs. D1 splits on semicolons, so a semicolon inside a string literal or a trigger body is split too. Whether a failed statement rolls back earlier ones is D1's and is not promised. A file over 1 MiB (1048576 bytes) is refused; apply it with Wrangler: wrangler d1 migrations apply. The path must be absolute, must not contain a symbolic link, and must not be a credential file.",
          "risk": "high",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "file": { "type": "string", "minLength": 1 }
            },
            "required": ["account_id", "database_id", "file"],
            "additionalProperties": false
          }
        },
        "delete_database": {
          "description": "Delete a D1 database and the data in it.",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "database_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": ["account_id", "database_id"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    },
    "rulesets": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CLOUDFLARE_API_KEY",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "create": {
          "description": "Create a ruleset",
          "risk": "high",
          "confirmation": "once",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "account_or_zone_id": { "type": "string" },
              "kind": { "type": "string" },
              "name": { "type": "string" },
              "phase": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["accounts_or_zones", "account_or_zone_id", "kind", "name", "phase"],
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Get a ruleset",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "accounts_or_zones": { "type": "string" },
              "ruleset_id": { "type": "string" },
              "account_id": { "type": "string" },
              "zone_id": { "type": "string" }
            },
            "required": ["accounts_or_zones", "ruleset_id"],
            "additionalProperties": false
          }
        },
        "delete": {
          "description": "Delete a ruleset",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
