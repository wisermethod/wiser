{
  "id": "bing",
  "service": "bing",
  "modules": {
    "webmaster": {
      "auth": {
        "provider": "catalog",
        "toolkit": "BING_WEBMASTER_TOOLS",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_sites": {
          "description": "List verified Webmaster Tools sites",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "search_performance": {
          "description": "Read search performance for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "report": { "type": "string", "enum": ["daily_totals", "top_queries", "top_pages"] }
            },
            "required": ["site_url", "report"],
            "additionalProperties": false
          }
        },
        "query_performance": {
          "description": "Read performance for one query on a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "query": { "type": "string" },
              "report": { "type": "string", "enum": ["daily", "pages", "page_daily"] },
              "page_url": { "type": "string" },
              "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "required": ["site_url", "query", "report"],
            "additionalProperties": false
          }
        },
        "page_performance": {
          "description": "Read performance for one page on a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "page_url": { "type": "string" },
              "report": { "type": "string", "enum": ["summary", "queries", "children"] },
              "page_number": { "type": "integer", "minimum": 1 }
            },
            "required": ["site_url", "page_url", "report"],
            "additionalProperties": false
          }
        },
        "crawl_diagnostics": {
          "description": "Read crawl issues or stats for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "report": { "type": "string", "enum": ["issues", "stats"] }
            },
            "required": ["site_url", "report"],
            "additionalProperties": false
          }
        },
        "inspect_url": {
          "description": "Inspect one URL as Bing stored it",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "url": { "type": "string" }
            },
            "required": ["site_url", "url"],
            "additionalProperties": false
          }
        },
        "feeds": {
          "description": "Read submitted feeds for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "feed_url": { "type": "string" }
            },
            "required": ["site_url"],
            "additionalProperties": false
          }
        },
        "inbound_links": {
          "description": "Read inbound links for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string" },
              "target_url": { "type": "string" },
              "page_number": { "type": "integer", "minimum": 1 }
            },
            "required": ["site_url"],
            "additionalProperties": false
          }
        },
        "research_keywords": {
          "description": "Research keyword impressions, history, or related queries",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "country": { "type": "string" },
              "language": { "type": "string" },
              "report": { "type": "string", "enum": ["impressions", "history", "related"] },
              "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "required": ["query", "country", "language", "report"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
