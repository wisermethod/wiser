{
  "id": "bing",
  "service": "bing",
  "modules": {
    "webmaster": {
      "auth": {
        "provider": "catalog",
        "toolkit": "BING_WEBMASTER_TOOLS",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list_sites": {
          "description": "List verified Webmaster Tools sites",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "search_performance": {
          "description": "Read search performance for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "report": { "type": "string", "enum": ["daily_totals", "top_queries", "top_pages"] }
            },
            "required": ["site_url", "report"],
            "additionalProperties": false
          }
        },
        "query_performance": {
          "description": "Read performance for one query on a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "query": { "type": "string" },
              "report": { "type": "string", "enum": ["daily", "pages", "page_daily"] },
              "page_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "required": ["site_url", "query", "report"],
            "additionalProperties": false
          }
        },
        "page_performance": {
          "description": "Read performance for one page on a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "page_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "report": { "type": "string", "enum": ["summary", "queries", "children"] },
              "page_number": { "type": "integer", "minimum": 1 }
            },
            "required": ["site_url", "page_url", "report"],
            "additionalProperties": false
          }
        },
        "crawl_diagnostics": {
          "description": "Read crawl issues or stats for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "report": { "type": "string", "enum": ["issues", "stats"] }
            },
            "required": ["site_url", "report"],
            "additionalProperties": false
          }
        },
        "inspect_url": {
          "description": "Inspect one URL as Bing stored it",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" }
            },
            "required": ["site_url", "url"],
            "additionalProperties": false
          }
        },
        "feeds": {
          "description": "Read submitted feeds for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "feed_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" }
            },
            "required": ["site_url"],
            "additionalProperties": false
          }
        },
        "inbound_links": {
          "description": "Read inbound links for a verified site",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "site_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "target_url": { "type": "string", "pattern": "^[\\u0000-\\u0020]*[Hh][Tt][Tt][Pp][Ss]?://" },
              "page_number": { "type": "integer", "minimum": 1 }
            },
            "required": ["site_url"],
            "additionalProperties": false
          }
        },
        "research_keywords": {
          "description": "Research keyword impressions, history, or related queries. The oneOf publishes that impressions and history require both dates; it cannot publish that related refuses them, and the module does",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "catalog" },
          "input": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "report": {
                "type": "string",
                "enum": [
                  "impressions",
                  "history",
                  "related"
                ]
              },
              "start_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "query",
              "country",
              "language",
              "report"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "report": {
                    "enum": [
                      "impressions",
                      "history"
                    ]
                  }
                },
                "required": [
                  "report",
                  "start_date",
                  "end_date"
                ]
              },
              {
                "properties": {
                  "report": {
                    "enum": [
                      "related"
                    ]
                  }
                },
                "required": [
                  "report"
                ]
              }
            ]
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
