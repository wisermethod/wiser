{
  "id": "vercel",
  "service": "vercel",
  "modules": {
    "projects": {
      "auth": {
        "provider": "catalog",
        "toolkit": "VERCEL",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List projects",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "team_id": {
                "type": "string"
              },
              "limit": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Read a project",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "id_or_name": {
                "type": "string"
              },
              "team_id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "id_or_name"
            ],
            "additionalProperties": false
          }
        },
        "list_domains": {
          "description": "List domains on a Vercel project. id_or_name is 1 to 100 letters, digits, dots, underscores, or hyphens. team_id, when given, is sent as the teamId query.",
          "risk": "low",
          "confirmation": "none",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "id_or_name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$" },
              "team_id": { "type": "string" }
            },
            "required": ["id_or_name"],
            "additionalProperties": false
          }
        },
        "remove_domain": {
          "description": "Remove a domain from a Vercel project. Sends no body. domain is a hostname. team_id, when given, is sent as the teamId query.",
          "risk": "destructive",
          "confirmation": "always",
          "execution": { "prefer": "proxy" },
          "input": {
            "type": "object",
            "properties": {
              "id_or_name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$" },
              "domain": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
              },
              "team_id": { "type": "string" }
            },
            "required": ["id_or_name", "domain"],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "deployments": {
      "auth": {
        "provider": "catalog",
        "toolkit": "VERCEL",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List deployments",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string"
              },
              "team_id": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Publish a deployment, uploading its files by reference first",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "dir": {
                "type": "string"
              },
              "files": {
                "type": "array"
              },
              "git_source": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type"
                ]
              },
              "project": {
                "type": "string"
              },
              "project_settings": {
                "type": "object"
              },
              "target": {
                "type": "string"
              },
              "skip_auto_detection": {
                "type": "boolean"
              },
              "team_id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "git_source"
                ]
              },
              {
                "required": [
                  "dir"
                ]
              },
              {
                "required": [
                  "files"
                ]
              }
            ]
          }
        },
        "upload_file": {
          "description": "Upload one local file to the deployment file store, by reference. path must name a readable file on the machine running the gateway, which is filesystem state no schema can publish",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "team_id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
