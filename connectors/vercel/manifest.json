{
  "id": "vercel",
  "service": "vercel",
  "modules": {
    "projects": {
      "auth": {
        "provider": "catalog",
        "toolkit": "VERCEL",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List projects",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "team_id": {
                "type": "string"
              },
              "limit": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "get": {
          "description": "Read a project",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "id_or_name": {
                "type": "string"
              },
              "team_id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "id_or_name"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    },
    "deployments": {
      "auth": {
        "provider": "catalog",
        "toolkit": "VERCEL",
        "scheme": "API_KEY",
        "privilege": "write"
      },
      "actions": {
        "list": {
          "description": "List deployments",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string"
              },
              "team_id": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "create": {
          "description": "Publish a deployment, uploading its files by reference first",
          "risk": "high",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "dir": {
                "type": "string"
              },
              "files": {
                "type": "array"
              },
              "git_source": {
                "type": "object"
              },
              "project": {
                "type": "string"
              },
              "project_settings": {
                "type": "object"
              },
              "target": {
                "type": "string"
              },
              "skip_auto_detection": {
                "type": "boolean"
              },
              "team_id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "upload_file": {
          "description": "Upload one local file to the deployment file store, by reference",
          "risk": "medium",
          "confirmation": "always",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "team_id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
}
