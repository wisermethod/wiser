{
  "id": "tinyfish",
  "service": "tinyfish",
  "modules": {
    "web": {
      "auth": {
        "provider": "catalog",
        "toolkit": "CUSTOM_TINYFISH",
        "scheme": "API_KEY",
        "privilege": "read"
      },
      "actions": {
        "search": {
          "description": "Search the web",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "include_domains": {
                "type": "string"
              },
              "exclude_domains": {
                "type": "string"
              },
              "domain_type": {
                "type": "string",
                "enum": [
                  "web",
                  "news",
                  "research_paper"
                ]
              },
              "page": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false
          }
        },
        "fetch": {
          "description": "Fetch up to ten HTTPS URLs",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "proxy"
          },
          "input": {
            "type": "object",
            "properties": {
              "urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"
                }
              },
              "format": {
                "type": "string",
                "enum": [
                  "markdown",
                  "html",
                  "json"
                ]
              }
            },
            "required": [
              "urls"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "none"
    }
  }
}
