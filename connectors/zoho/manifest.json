{
  "id": "zoho",
  "service": "zoho",
  "modules": {
    "crm": {
      "auth": {
        "provider": "catalog",
        "toolkit": "ZOHO",
        "scheme": "OAUTH2",
        "privilege": "write"
      },
      "actions": {
        "get": {
          "description": "get",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "fields": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "page_token": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "search": {
          "description": "search",
          "risk": "low",
          "confirmation": "none",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "word": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "criteria": {
                "type": "string"
              },
              "fields": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "create": {
          "description": "create",
          "risk": "medium",
          "confirmation": "once",
          "execution": {
            "prefer": "catalog"
          },
          "input": {
            "type": "object",
            "properties": {
              "last_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "first_name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "lead_source": {
                "type": "string"
              },
              "lead_status": {
                "type": "string"
              },
              "website": {
                "type": "string"
              }
            },
            "required": [
              "last_name"
            ],
            "additionalProperties": false
          }
        }
      },
      "unwrap_token": false,
      "fallback": "catalog"
    }
  }
