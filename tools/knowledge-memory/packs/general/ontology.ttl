@prefix : <https://wisermethod.org/ontology/general#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The general pack's ontology skeleton. Cognee matches extracted names against the
# classes and individuals here AFTER extraction; it never writes back into this
# file. A new canonical name is a human edit here or in a set's own pack, never an
# agent's.
#
# Mode: annotate. Unmatched entities are kept and marked Candidate. The engine's
# documentation describes a strict mode that drops unmatched entities; it is
# unverified for the pinned version, no recipe key selects it, and it is
# TODO(Solve) before any set relies on it.
#
# This skeleton carries classes and no individuals on purpose. Individuals are the
# canon, and the canon belongs to the set that confirmed it.

<https://wisermethod.org/ontology/general> a owl:Ontology ;
    rdfs:label "Wiser general knowledge ontology" ;
    owl:versionInfo "0.1.0" .

:Entity a owl:Class ; rdfs:label "Entity" .
:Person a owl:Class ; rdfs:subClassOf :Entity ; rdfs:label "Person" .
:Organization a owl:Class ; rdfs:subClassOf :Entity ; rdfs:label "Organization" .
:Work a owl:Class ; rdfs:subClassOf :Entity ; rdfs:label "Work" ;
    rdfs:comment "A book, article, post, page, recording, or other authored thing." .
:Place a owl:Class ; rdfs:subClassOf :Entity ; rdfs:label "Place" .
:Term a owl:Class ; rdfs:subClassOf :Entity ; rdfs:label "Term of art" .

:Idea a owl:Class ; rdfs:label "Idea" ;
    rdfs:comment "A reusable claim, method, principle, pattern, or decision theme." .
:Fact a owl:Class ; rdfs:label "Fact" .
:Decision a owl:Class ; rdfs:label "Decision" .
:OpenQuestion a owl:Class ; rdfs:label "Open question" .

:exemplifies a owl:ObjectProperty ; rdfs:label "EXEMPLIFIES" ; rdfs:domain :Idea .
:dependsOn a owl:ObjectProperty ; rdfs:label "DEPENDS_ON" ; rdfs:domain :Idea ; rdfs:range :Idea .
:contradicts a owl:ObjectProperty ; rdfs:label "CONTRADICTS" .
:specializes a owl:ObjectProperty ; rdfs:label "SPECIALIZES" ; rdfs:domain :Idea ; rdfs:range :Idea .
:decidedIn a owl:ObjectProperty ; rdfs:label "DECIDED_IN" ; rdfs:domain :Idea ; rdfs:range :Decision .
:appliesTo a owl:ObjectProperty ; rdfs:label "APPLIES_TO" ; rdfs:domain :Idea .

:status a owl:DatatypeProperty ; rdfs:label "status" ; rdfs:range xsd:string ;
    rdfs:comment "Candidate | Canonical | Alias | Stale | Rejected" .
:quote a owl:DatatypeProperty ; rdfs:label "quote" ; rdfs:range xsd:string ;
    rdfs:comment "Verbatim, 40 words at most, from the source chunk." .
