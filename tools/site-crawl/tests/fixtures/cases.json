[
  {
    "name": "inventory",
    "input": {
      "start": "https://example.com/",
      "maxPages": 3,
      "delayMs": 0
    },
    "responses": {
      "https://example.com/robots.txt": {
        "body": "User-agent: *\nDisallow: /secret\n"
      },
      "https://example.com/": {
        "headers": {
          "content-type": "text/html"
        },
        "body": "<html lang=\"en\"><title>Home &amp; Start</title><meta name=\"description\" content=\"yes\"><meta name=\"robots\" content=\"noindex\"><link rel=\"canonical\" href=\"/canonical\"><h1>Home</h1><a href=\"/go\">go</a><a href=\"/file.pdf\">pdf</a><a href=\"/secret\">secret</a><a href=\"/later\">later</a></html>"
      },
      "https://example.com/go": {
        "status": 302,
        "headers": {
          "location": "/hop"
        },
        "body": ""
      },
      "https://example.com/hop": {
        "status": 301,
        "headers": {
          "location": "/land"
        },
        "body": ""
      },
      "https://example.com/land": {
        "headers": {
          "content-type": "text/html"
        },
        "body": "<title>Home &amp; Start</title><a href=\"/deep\">deep</a>"
      },
      "https://example.com/file.pdf": {
        "headers": {
          "content-type": "application/pdf",
          "content-length": "8",
          "x-robots-tag": "noindex"
        },
        "body": "%PDF-1.4"
      }
    },
    "requests": [
      "https://example.com/robots.txt",
      "https://example.com/",
      "https://example.com/go",
      "https://example.com/hop",
      "https://example.com/land",
      "https://example.com/file.pdf"
    ],
    "expected": "inventory.expected.json"
  },
