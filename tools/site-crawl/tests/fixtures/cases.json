  {
    "name": "subdomains-and-offhost",
    "input": {
      "start": "https://example.com/",
      "maxPages": 3,
      "delayMs": 0,
      "includeSubdomains": true
    },
    "responses": {
      "https://example.com/robots.txt": {
        "status": 410
      },
      "https://example.com/": {
        "headers": {
          "content-type": "text/html"
        },
        "body": "<a href=\"https://www.example.com/\">sub</a><a href=\"/off\">off</a>"
      },
      "https://www.example.com/robots.txt": {
        "status": 404
      },
      "https://www.example.com/": {
        "headers": {
          "content-type": "text/html"
        },
        "body": "<title>Sub</title>"
      },
      "https://example.com/off": {
        "status": 302,
        "headers": {
          "location": "https://elsewhere.test/"
        },
        "body": ""
      }
    },
    "requests": [
      "https://example.com/robots.txt",
      "https://example.com/",
      "https://www.example.com/robots.txt",
      "https://www.example.com/",
      "https://example.com/off"
    ],
    "expected": "subdomains-and-offhost.expected.json"
  },
